import math
with open("input.txt", 'r') as f:
    s = [[int(x) for x in line.strip(' ').split()] for line in f]
L=s

def safe_or_not(L,n=False):
    c=0
    for i in L:
        sign = math.copysign(1, i[0] - i[-1]) if i[0] != i[-1] else 0
        if sign==0 : continue 
        for j in range(len(i)-1):
            offset=i[j]-i[j+1]
            if offset==0 : 
                n=True
                break
            if abs(offset)>3:
                n=True
                break
            if offset/abs(offset)!=sign:
                n=True
                break 
        if n==True : 
            n=False
            continue
        c+=1
    return c
        
print(safe_or_not(L))

