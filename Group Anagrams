def groupAnagrams(self, strs: List[str]) -> List[List[str]]:
        solve=[]
        while len(strs)>1:
            l2=[strs[0]]
            for i in range(1,len(strs)):
                if sorted(strs[0])==sorted(strs[i]):
                    l2.append(strs[i])
            for i in l2:
                strs.remove(i)
            solve.append(l2)
        if len(strs)==1:
            solve.append([strs[0]])
        return solve
