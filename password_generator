import random
lower_case='abcdefghijklmnopqrstvwxyz'
upper_case='ABCDDEFGHIJKLMNOPQRSTVWXYZ'
nums='0123456789'
special='!@#$%^&*()_+'

def generate_pass(a,b,c,d,N,M):
    passwords=[]
    for i in range(M):
        password=''
        for i in range(a):
            password+=random.choice(lower_case)
        for i in range(b):
            password+=random.choice(upper_case)
        for i in range(c):
            password+=random.choice(nums)
        for i in range(d):
            password+=random.choice(special)
        while len(password)<N:
            password+=random.choice(lower_case+upper_case+nums+special)
        pass_as_list=list(password)
        for i in range(len(pass_as_list)):
            random_position=random.randint(0,len(pass_as_list)-1)
            pass_as_list[i],pass_as_list[random_position]=pass_as_list[random_position],pass_as_list[i]
        passwords.append(''.join(pass_as_list))
    return passwords
        
print(generate_pass(3,5,3,4,8,4))
